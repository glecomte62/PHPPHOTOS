Options -Indexes
DirectoryIndex index.php

# Limites d'envoi PHP : sur O2switch, .user.ini et php_value sont ignorés.
# Elles se règlent pour tout le compte via le sélecteur PHP CloudLinux :
#   selectorctl --interpreter=php -v 8.5 --add-options=upload_max_filesize:64M,post_max_size:64M

RewriteEngine On

# Validation des certificats Let's Encrypt
RewriteRule ^\.well-known/ - [L]

# HTTPS obligatoire (sauf en local)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Tout ce qui n'est pas un fichier existant passe par index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L,QSA]

# Fichiers cachés (.env, .user.ini…) jamais servis
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    <FilesMatch "\.(css|js|webp|jpg|jpeg|png|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
