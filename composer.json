{
    "name": "glecomte/portfolio",
    "description": "Portfolio photo de Guillaume Lecomte",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "ext-exif": "*",
        "ext-pdo": "*",
        "ext-fileinfo": "*",
        "ext-dom": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
