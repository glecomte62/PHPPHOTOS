APP_DEBUG=1
APP_URL=http://localhost:8000
# 64 caractères hexadécimaux : php -r 'echo bin2hex(random_bytes(32));'
APP_KEY=

DB_HOST=localhost
DB_NAME=portfolio_local
DB_USER=root
DB_PASS=

MAIL_HOST=
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
